# MediGuide environment variables. Copy to .env.local and fill in what you have.
# Everything is optional for local development: without credentials the app uses an
# embedded Postgres (PGlite), local file storage, demo sign-in and sample-document fixtures.
# Never commit real values. Never prefix secrets with NEXT_PUBLIC_.

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Supabase Postgres). Use the transaction pooler URI (port 6543). ---
DATABASE_URL=

# --- Supabase Auth + Storage ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for private storage and to look up reminder email addresses.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=instruction-documents

# --- AI via Groq (server-only) ----------------------------------------------------------
# Without a key, only the bundled fictional samples can be "extracted" (clearly labelled fixtures).
GROQ_API_KEY=
AI_EXTRACTION_MODEL=qwen/qwen3.8-27b
AI_SUMMARY_MODEL=openai/gpt-oss-120b

# --- Demo mode -----------------------------------------------------------------
# Enables fictional demo accounts. Automatically on in development when Supabase isn't configured.
# Set to true on a hackathon demo deployment only; never with real user data.
MEDIGUIDE_DEMO_MODE=
# Required whenever demo mode is used outside local development. Generate: openssl rand -base64 32
DEMO_SESSION_SECRET=
# Local-only data directory for PGlite and uploads.
MEDIGUIDE_DATA_DIR=.data

# --- Reminder delivery ---------------------------------------------------------
# Bearer token the scheduler must send to /api/cron/dispatch-reminders.
CRON_SECRET=
# Optional email channel (Resend). Emails contain no medicine names.
RESEND_API_KEY=
REMINDER_EMAIL_FROM=

# --- Monitoring (optional) -----------------------------------------------------
SENTRY_DSN=
